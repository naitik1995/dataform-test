      `naitik-poc-test.CDC_SAP_V_6_0.mara` AS MARA
    INNER JOIN
      `naitik-poc-test.CDC_SAP_V_6_0.makt` AS MAKT
      ON
        MARA.MANDT = MAKT.MANDT
        AND MARA.MATNR = MAKT.MATNR
